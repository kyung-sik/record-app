# ── 비밀정보 템플릿 ──
# 이 파일을 복사해서 secrets.toml 을 만들고 실제 값을 채우세요.
# (secrets.toml 은 .gitignore 에 의해 GitHub 에 올라가지 않습니다.)
#
# 클라우드(Streamlit Cloud)에서는 이 파일을 올리는 게 아니라,
# Streamlit Cloud 대시보드의 "Secrets" 설정란에 아래 내용을 그대로 붙여넣습니다.

# 앱 로그인 비밀번호
app_password = "여기에-원하는-비밀번호"

# 데이터베이스(Supabase Postgres) 연결 주소
# Supabase → Project Settings → Database → Connection string(URI) 값을 붙여넣으세요.
# 이 줄을 비워두거나 지우면 로컬 SQLite(record.db)로 동작합니다.
[database]
url = "postgresql://postgres.xxxx:비밀번호@aws-0-지역.pooler.supabase.com:6543/postgres"
